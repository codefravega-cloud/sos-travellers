  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "opening_hours": "^3.15.0",
