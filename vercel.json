{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/equipo",
      "destination": "/index.html"
    },
    {
      "source": "/panel",
      "destination": "/index.html"
    },
    {
      "source": "/r/:id",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-summary",
      "schedule": "0 13 * * 1"
    }
  ]
}
