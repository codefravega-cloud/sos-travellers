SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GOOGLE_MAPS_API_KEY=your-google-places-api-key

# Opcional: el panel (/panel) ya trae el proyecto y su clave publicable en src/supabase-browser.ts.
# Solo define estas dos para apuntar a otro proyecto de Supabase. Nunca pongas aquí la service_role.
# VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# VITE_SUPABASE_KEY=sb_publishable_xxxxxxxx

# Agentes: AGENT_KEY solo permite proponer eventos como borrador (mínimo 24 caracteres);
# CRON_SECRET es la que Vercel Cron envía al resumen semanal (mínimo 16).
AGENT_KEY=clave-larga-al-azar-para-el-agente
CRON_SECRET=otra-clave-larga-al-azar

# Cifra el RUT de los usuarios (tbl_usuarios_privado). Mínimo 32 caracteres, solo en el servidor.
# No la cambies una vez usada: los RUT guardados con la clave anterior ya no se podrían leer.
RUT_SECRET=clave-larga-al-azar-de-32-caracteres-o-mas
